# FloodGuard Penang - environment contract.
# Copy to `.env` for local use. `.env` is git-ignored; never commit real values.
# Active lines are used now. Commented lines are planned for the phase noted and
# are NOT required until that phase lands; uncomment them then.
# Naming: FLOODGUARD_* for project settings; tool-standard names where a tool
# already reads one (POSTGRES_*, MLFLOW_TRACKING_URI).

# --- Application / runtime (Phase 0) -----------------------------------------
# One of: development, test, staging, production
FLOODGUARD_ENV=development
FLOODGUARD_LOG_LEVEL=INFO
# Observation timestamps are interpreted in this zone; store UTC alongside.
FLOODGUARD_TIMEZONE=Asia/Kuala_Lumpur
FLOODGUARD_DATA_DIR=data

# --- Database: PostgreSQL / PostGIS (Phase 0 Docker baseline, Phase 8 live) ---
# Read by compose.yaml, which falls back to these same defaults if unset.
# Local development values only. Use a secrets manager outside local dev.
POSTGRES_USER=floodguard
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=floodguard
# Host port on 127.0.0.1; change if 5432 is already in use locally.
FLOODGUARD_POSTGRES_PORT=5432
# Application connection string (active since Phase 8; backend/config.py).
# Keep the placeholder password; never commit real credentials.
FLOODGUARD_DATABASE_URL=postgresql://floodguard:change-me-local-only@localhost:5432/floodguard

# --- MLflow / model artifacts (planned: Phase 7) -----------------------------
# MLFLOW_TRACKING_URI=http://localhost:5000
# FLOODGUARD_MODEL_NAME=floodguard-flood-risk

# --- Upstream data sources (planned: Phase 1 verification) -------------------
# Access methods, endpoints, auth, rate limits, and terms are NOT yet verified.
# Add variables here only after Phase 1 documents the verified access method.
# Do not add a token for a source that does not require one.
# FLOODGUARD_JPS_BASE_URL=
# FLOODGUARD_METMALAYSIA_BASE_URL=
# FLOODGUARD_HTTP_TIMEOUT_SECONDS=30

# --- Internal service URLs (planned: Phase 8-9) ------------------------------
# Streamlit and React consume the FastAPI service, not ML code directly.
# React build-time variables live in `frontend/.env*`, not here.
# FLOODGUARD_API_URL=http://localhost:8000

# --- Monitoring (planned: Phase 12) ------------------------------------------
# Prometheus scrapes the API's /metrics endpoint; no variable required yet.

# --- Alert delivery (optional, planned: Phase 11) ----------------------------
# Channel is not chosen yet (Telegram, email, or webhook per docs/18).
# Add only the variables for the selected channel, as secrets.
# FLOODGUARD_ALERT_WEBHOOK_URL=
