# FloodGuard FastAPI base URL (no trailing slash). No secrets belong in frontend env vars.
VITE_API_BASE_URL=http://localhost:8000
# MapLibre style URL for the light basemap. Leave empty to render markers without a basemap.
# Verify the tile provider's licence and attribution before any public deployment.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Polling interval for live data (ms), aligned with the ingestion cadence.
VITE_POLL_INTERVAL_MS=60000
# Optional raster-dem tiles (Terrarium encoding) for the 3D map, e.g. AWS Terrain Tiles:
# https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png  (open data; attribution required)
# Empty = 3D view tilts and extrudes buildings without terrain.
VITE_TERRAIN_URL=
VITE_TERRAIN_ATTRIBUTION=Elevation: Terrain Tiles (AWS Open Data, Mapzen)
